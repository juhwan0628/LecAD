# LecAD provider configuration
# Copy to .env and add credentials for the TTS provider you choose.
# Codex VLM uses the already-authenticated Codex CLI, so it needs no API key.

LECAD_PROVIDER=codex
LECAD_CODEX_MODEL=gpt-5.6-terra
LECAD_CODEX_REASONING_EFFORT=low
LECAD_CODEX_TIMEOUT_S=120

# TTS: gemini | openai | edge | mock
LECAD_TTS_PROVIDER=gemini

# Gemini TTS (recommended production default)
GEMINI_API_KEY=
LECAD_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
LECAD_GEMINI_TTS_VOICE=Kore

# OpenAI TTS alternative
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LECAD_TTS_MODEL=gpt-4o-mini-tts
LECAD_TTS_VOICE=cedar

# No-key demo fallback
LECAD_EDGE_TTS_VOICE=ko-KR-SunHiNeural
LECAD_EDGE_TTS_RATE=+10%

LECAD_GATE_MIN_CONFIDENCE=0.6
